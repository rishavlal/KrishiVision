# KrishiVision AI - Environment Template Example
# ===============================================
# Copy this file to .env and configure for your environment.

APP_ENV=development
SECRET_KEY=your_secure_random_secret_key_here

# Demo User Settings (optional, development only)
DEMO_USER_ENABLED=false
DEMO_USER_USERNAME=demo_farmer
DEMO_USER_EMAIL=farmer@example.com
DEMO_USER_PASSWORD=ChangeThisPassword123
DEMO_USER_NAME=Demo Farmer
DEMO_USER_LOCATION=Ranchi, Jharkhand
DEMO_USER_FARM_SIZE=3.5

# Database URL (optional, defaults to local SQLite krishivision.db)
# DATABASE_URL=sqlite:///krishivision.db
